{
  "$comment": "Official servers the registry and site crawl can't find. Keys are an index key (domain, host, or host/first-path-segment). Keywords match third-party servers to these pages by name.",
  "entries": [
    {
      "keys": [
        "mail.google.com"
      ],
      "keywords": [
        "gmail"
      ],
      "server": {
        "id": "google/gmail",
        "title": "Gmail",
        "publisher": "Google",
        "description": "Search threads, read messages, draft email and manage labels.",
        "docsUrl": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "setupUrl": "https://developers.google.com/workspace/guides/configure-mcp-servers",
        "setupNote": "Google needs a Cloud project and OAuth client first.",
        "install": {
          "kind": "remote",
          "transport": "http",
          "url": "https://gmailmcp.googleapis.com/mcp/v1",
          "headers": []
        }
      }
    },
