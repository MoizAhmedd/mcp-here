{
  "name": "mcp-here",
  "version": "0.1.0",
  "description": "Chrome extension that shows when a site has an MCP server and adds it to your agent in one click.",
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "index": "node scripts/build-index.ts",
    "zip": "npm run build && cd dist && zip -qr ../mcp-here.zip ."
  },
  "author": "Moiz Ahmed",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "tldts": "^7.4.15"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
